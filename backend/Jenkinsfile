pipeline {
    agent any

    tools {
        maven 'mvn3'
        jdk 'jdk21'
    }

    environment {
        SONAR_HOME = tool('sonar')

        IMAGE_NAME          = 'claw4321/termistack-backend'
        DOCKER_REGISTRY_URL = 'https://index.docker.io/v1/'
        TRIVY_SEVERITY      = 'HIGH,CRITICAL'
        TRIVY_EXIT_CODE     = '0'
        SYFT_FORMAT         = "spdx-json"
        NEXUS_URL           = "http://192.168.122.218:8081"
        NEXUS_REPO          = ""
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Optional Docker image tag'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/AmulThantharate/TermiStack.git'
            }
        }

        stage('Image Tag') {
            steps {
                script {
                    if (params.IMAGE_TAG?.trim()) {
                        env.IMAGE_TAG = params.IMAGE_TAG
                    } else {
                        env.IMAGE_TAG = sh(
                            script: 'git log -1 --format="%h"',
                            returnStdout: true
                        ).trim()
                    }

                    echo "USING IMAGE_TAG = ${env.IMAGE_TAG}"

                    // Determine if it's a Snapshot or Release
                    dir('./backend') {
                        def mvnVersion = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
                        env.NEXUS_REPO = mvnVersion.endsWith('SNAPSHOT') ? 'snapshot' : 'release'
                    }
                    echo "DETECTED REPO TYPE = ${env.NEXUS_REPO}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('./backend') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Compile') {
            steps {
                dir('./backend') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('./backend') {
                    echo 'Running backend unit tests...'
                    sh 'mvn test'
                }
            }
        }

        stage("SonarQube Analysis"){
          steps{
            withSonarQubeEnv('sonar') {
            sh """
              ${SONAR_HOME}/bin/sonar-scanner \
              -Dsonar.projectName='termistack-backend' \
              -Dsonar.projectKey='termistack-backend' \
              -Dsonar.sources=./backend \
              -Dsonar.java.binaries=./backend/target/classes
            """
          }
        }
      }

      stage("Quality Gate"){
          steps {
            timeout(time: 5, unit: "MINUTES") {
              waitForQualityGate abortPipeline: true
            }
          }
      }

      stage('Upload to Nexus') {
        steps {
          dir('backend') {
            withCredentials([
              usernamePassword(
                credentialsId: 'nexus-creds',
                usernameVariable: 'NEXUS_USER',
                passwordVariable: 'NEXUS_PASS'
              )
            ]) {
              script {
                def settingsXml = """
                <settings>
                    <servers>
                        <server>
                            <id>nexus</id>
                            <username>${NEXUS_USER}</username>
                            <password>${NEXUS_PASS}</password>
                        </server>
                    </servers>
                </settings>
                """
                writeFile file: 'settings.xml', text: settingsXml

                // Determine repository profile suffix dynamically in the current stage scope as a robust fallback
                def profileSuffix = (env.NEXUS_REPO && env.NEXUS_REPO != 'null' && env.NEXUS_REPO != "") ? env.NEXUS_REPO : (sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim().endsWith('SNAPSHOT') ? 'snapshot' : 'release')

                echo "Activating Maven profile: nexus-${profileSuffix}"

                sh """
                    mvn clean deploy \
                    -s settings.xml \
                    -Pnexus-${profileSuffix} \
                    -Dnexus.url=${env.NEXUS_URL} \
                    -DskipTests \
                    --batch-mode
                """
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
              }
            }
          }
        }
      }


      stage("Trivy File System Scan"){
        steps{
            sh "mkdir -p reports/backend && trivy fs ./backend --format table -o reports/backend/trivy-fs-report.html"
        }
        post{
          always {
            publishHTML([
              allowMissing: false,
              alwaysLinkToLastBuild: true,
              keepAll: true,
              reportDir: 'reports/backend',
              reportFiles: 'trivy-fs-report.html',
              reportName: 'Trivy File System Scan'
            ])
          }
        }
      }

      stage("Docker Build"){
        steps{
          dir("./backend"){
            sh "docker build -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest ."
          }
        }
      }

      stage("Trivy Image Scan"){
        steps{
          sh "trivy image --format table -o reports/backend/trivy-image-report.html $IMAGE_NAME:$IMAGE_TAG"
        }
        post{
          always {
            publishHTML([
              allowMissing: false,
              alwaysLinkToLastBuild: true,
              keepAll: true,
              reportDir: 'reports/backend',
              reportFiles: 'trivy-image-report.html',
              reportName: 'Trivy Image Scan'
            ])
          }
        }
      }

      stage('Security Scans') {
      parallel {

        stage('Trivy Image Scan') {
          steps {
            sh """
              trivy image \
                --severity ${TRIVY_SEVERITY} \
                --exit-code ${TRIVY_EXIT_CODE} \
                ${IMAGE_NAME}:${IMAGE_TAG}
            """
          }
        }

        stage('Syft SBOM') {
          steps {
            sh """
              syft ${IMAGE_NAME}:${IMAGE_TAG} \
              -o ${SYFT_FORMAT} > syft-frontend-sbom.json
            """
            archiveArtifacts artifacts: 'syft-frontend-sbom.json', allowEmptyArchive: true
          }
        }
      }
    }


      stage("Docker Push"){
        steps{
          withCredentials([usernamePassword(credentialsId: 'DOCKER_CRED', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
            sh """
              echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
              docker push $IMAGE_NAME:$IMAGE_TAG
              docker push $IMAGE_NAME:latest
            """
          }
        }
      }

  }
}

