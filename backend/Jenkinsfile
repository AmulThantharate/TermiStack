pipeline {
    agent any

    tools {
        maven 'mvn3'
        jdk 'jdk21'
    }

    environment {
        SONAR_HOME = tool('sonar')

        IMAGE_NAME          = 'claw4321/termistack-backend'
        DOCKER_REGISTRY_URL = 'https://index.docker.io/v1/'
        TRIVY_SEVERITY      = 'HIGH,CRITICAL'
        TRIVY_EXIT_CODE     = '0'
        SYFT_FORMAT         = "spdx-json"
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Optional Docker image tag'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/AmulThantharate/TermiStack.git'
            }
        }

        stage('Image Tag') {
            steps {
                script {
                    if (params.IMAGE_TAG?.trim()) {
                        env.IMAGE_TAG = params.IMAGE_TAG
                    } else {
                        env.IMAGE_TAG = sh(
                            script: 'git log -1 --format="%h"',
                            returnStdout: true
                        ).trim()
                    }

                    echo "USING IMAGE_TAG = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('./backend') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Compile') {
            steps {
                dir('./backend') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('./backend') {
                    echo 'Running backend unit tests...'
                    sh 'mvn test'
                }
            }
        }

        stage("SonarQube Analysis"){
          steps{
            withSonarQubeEnv('sonar') {
            sh """
              ${SONAR_HOME}/bin/sonar-scanner \
              -Dsonar.projectName='termistack-backend' \
              -Dsonar.projectKey='termistack-backend' \
              -Dsonar.sources=./backend \
              -Dsonar.java.binaries=./backend/target/classes
            """
          }
        }
      }

      stage("Quality Gate"){
          steps {
            timeout(time: 5, unit: "MINUTES") {
              waitForQualityGate abortPipeline: true
            }
          }
      }

      stage("Trivy File System Scan"){
        steps{
            sh "mkdir -p reports/backend && trivy fs ./backend --format table -o reports/backend/trivy-fs-report.html"
        }
        post{
          always {
            publishHTML([
              allowMissing: false,
              alwaysLinkToLastBuild: true,
              keepAll: true,
              reportDir: 'reports/backend',
              reportFiles: 'trivy-fs-report.html',
              reportName: 'Trivy File System Scan'
            ])
          }
        }
      }

      stage("Docker Build"){
        steps{
          dir("./backend"){
            sh """
              docker build \
              --cache-from $IMAGE_NAME:$IMAGE_TAG \
              -t $IMAGE_NAME:$IMAGE_TAG \
              -t $IMAGE_NAME:latest \
              -f Dockerfile .
            """
          }
        }
      }
    }

}
