# ==========================================
# TermiStack Git Ignore Configuration
# ==========================================

# OS Specific
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
# ------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.iml
*.ipr
*.iws

# Build Reports and Scan Results
# ------------------------------------------
reports/
trivy-*.html
trivy-*.json
**/reports/

# ==========================================
# Backend (Spring Boot & Maven)
# ==========================================
backend/target/
**/target/
backend/settings.xml
**/settings.xml

# Maven packaging
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven local configs
.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml

# ==========================================
# Frontend (Next.js & React)
# ==========================================
frontend/node_modules/
**/node_modules/
frontend/.next/
**/.next/
frontend/out/
**/out/
frontend/build/
**/build/

# Next.js local environment files (potentially containing secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env*

# NPM/Yarn Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Other tools
.eslintcache
.stylelintcache
